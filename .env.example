# Copy to .env and fill in values as needed. Never commit a real .env file.

# --- Pricing formula (see insurance_analytics.config.PricingConfig) -----------------
PRICING_EXPENSE_LOADING_PCT=0.10
PRICING_PROFIT_MARGIN_PCT=0.15

# --- API ------------------------------------------------------------------------------
# Optional shared secret required as the X-API-Key header on /predict and /insights routes.
# Leave unset for local development (auth is a no-op when this is empty).
API_KEY=

# --- AI insight generation (optional) --------------------------------------------------
# Without this, /insights/generate falls back to a deterministic template report.
ANTHROPIC_API_KEY=

# --- Logging ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- ML ---------------------------------------------------------------------------------
RANDOM_STATE=42
TEST_SIZE=0.2
CURRENT_YEAR=2015
